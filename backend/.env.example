# SahakarGig Backend Environment Variables
PORT=5000

# MongoDB Atlas Connection String (replace with your MongoDB Atlas or local MongoDB URI)
# In-Memory Mode fallback automatically activates if this is omitted.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sahakargig?retryWrites=true&w=majority

# Client Origin (CORS)
CLIENT_URL=http://localhost:3000

# Real Email Authenticator (Gmail App Password or Custom SMTP)
# To send REAL emails to actual inboxes:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password under "App passwords": https://myaccount.google.com/apppasswords
# 3. Enter your email and 16-character App Password below:
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="SahakarGig Security" <your-email@gmail.com>

