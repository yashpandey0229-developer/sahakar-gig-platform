# SahakarGig Backend Environment Variables
PORT=5000

# MongoDB Atlas Connection String (replace with your MongoDB Atlas or local MongoDB URI)
# In-Memory Mode fallback automatically activates if this is omitted.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sahakargig?retryWrites=true&w=majority

# Client Origin (CORS)
CLIENT_URL=http://localhost:3000
