# SahakarGig Environment Configuration

# Server Port
PORT=5000

# MongoDB Atlas Connection String (Replace with your free MongoDB Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/sahakargig?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://demoUser:demoPass123@cluster0.mongodb.net/sahakargig?retryWrites=true&w=majority

# Client Origin (for CORS)
CLIENT_URL=http://localhost:3000

# Optional: Real Email OTP Delivery (Gmail App Password or SMTP)
# SMTP_SERVICE=gmail
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password

# Optional: Real Telecom SMS Gateway (Fast2SMS for India)
# FAST2SMS_API_KEY=your_fast2sms_api_key
